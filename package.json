{
  "name": "hk-transit-ai",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:journey-index": "node scripts/build-journey-index.cjs",
    "verify:journey-index": "node scripts/verify-journey-index.cjs",
    "build:web": "npm run build:journey-index && npm run verify:journey-index && expo export --platform web && node scripts/post-build.js",
    "deploy": "npm run build:web && npx gh-pages -d dist -m \"deploy: web build\"",
    "test": "jest",
    "lint": "eslint .",
    "test:core": "node scripts/run-core-tests.cjs",
    "verify:source": "node scripts/verify-source.cjs",
    "verify:handoff": "node scripts/verify-handoff.cjs",
    "verify": "npm run test:core && npm run verify:types && npm run verify:source && npm run verify:mobile && npm run verify:handoff",
    "data:refresh": "node scripts/fetch-transit-data.js",
    "verify:types": "node scripts/verify-types.cjs",
    "verify:mobile": "node scripts/verify-mobile-ux.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.7",
    "expo-router": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "i18next": "^24.0.0",
    "leaflet": "^1.9.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.0.0",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.26.2",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "jest": "^29.0.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.7.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transformIgnorePatterns": [
      "node_modules/(?!(expo|expo-router|@expo|expo-constants|expo-modules-core|expo-linking|expo-localization|expo-location|expo-status-bar|react-native|react-native-web|@react-native|i18next|react-i18next|zustand)/)"
    ],
    "setupFiles": [
      "<rootDir>/node_modules/jest-expo/src/preset/setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "private": true
}
