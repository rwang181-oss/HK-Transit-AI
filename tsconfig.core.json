{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".core-test-dist",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/journey/providers/types.ts",
    "src/journey/model/types.ts",
    "src/journey/data/kmbTopology.ts",
    "src/journey/data/journeyDataLoader.ts",
    "src/journey/graph/stopMerger.ts",
    "src/journey/graph/travelTime.ts",
    "src/journey/graph/graphBuilder.ts",
    "src/journey/planner/planner.ts",
    "src/journey/planner/routePolicies.ts",
    "src/journey/planner/candidatePools.ts",
    "src/journey/walking/walkingRouter.ts",
    "src/journey/comfort/**/*.ts",
    "src/journey/realtime/etaEstimator.ts",
    "src/journey/providers/gmbParser.ts",
    "src/journey/realtime/departureSelector.ts",
    "src/journey/realtime/navigationTiming.ts",
    "src/journey/providers/routeDisplay.ts",
    "src/utils/requestCache.ts",
    "src/utils/asyncPool.ts",
    "src/utils/versionMonitor.ts"
  ]
}
